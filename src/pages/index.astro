---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Bento from '../components/Bento.astro';
import Gallery from '../components/Gallery.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';

const title = "RAMSER S.A.S | Fumigación y Control de Plagas en Pampa del Infierno, Chaco";
const description = "Empresa líder en fumigación y control de plagas en Pampa del Infierno, Chaco. Servicios profesionales de desinsectación, desratización y saneamiento ambiental. Habilitación Provincial N°2952. Contacto: 3644-598253. Atención 24/7.";
const keywords = "fumigación Pampa del Infierno, control plagas Chaco, desinsectación, desratización, saneamiento ambiental, fumigador profesional, exterminador, control roedores, control insectos, fumigación viviendas, fumigación comercial, fumigación industrial, empresa fumigación NEA, habilitación provincial 2952";
---

<Layout title={title} description={description} keywords={keywords}>
	<Header/>
	<main>
		<Hero/>
		<section id="Servicios" aria-label="Servicios de Fumigación y Control de Plagas">
			<Bento/>
		</section>
		<section id="Nuestros-Trabajos" aria-label="Galería de Trabajos Realizados">
			<Gallery/>
		</section>
	</main>
	<Footer/>
</Layout>


