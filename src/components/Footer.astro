---
import { business } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="on-ink bg-ink pb-20 text-paper md:pb-10">
	<div class="mx-auto w-full max-w-page px-5 md:px-10">
		<div class="flex flex-col gap-5 border-t border-paper/30 pt-6 md:flex-row md:items-center md:justify-between">
			<div class="flex items-center gap-3">
				<img src="/logo.png" width="642" height="389" alt="" class="h-8 w-auto" loading="lazy" />
				<p class="font-sans text-base font-medium">{business.name}</p>
				<p class="mono-label text-paper/75">Hab. Prov. N°{business.license.number}</p>
			</div>
			<div class="mono-label flex flex-col gap-1 text-paper/75 md:items-end">
				<p>© {year} RamSer S.A.S. Todos los derechos reservados.</p>
				<p>
					Sitio web por
					<a href="https://empulse.site" target="_blank" rel="noopener noreferrer" class="text-paper underline underline-offset-4">Empulse</a>
				</p>
			</div>
		</div>
	</div>
</footer>
