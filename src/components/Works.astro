---
import Photo from './Photo.astro';
import SectionHead from './SectionHead.astro';
import { gallery, services } from '../data/site';

// Each photo appears once on the page: fum2 lives in the field band, and any photo
// already shown in the services list is skipped.
const usedElsewhere = new Set<string>([gallery[0].image, ...services.map((s) => s.image)]);
const items = gallery.filter((item) => !usedElsewhere.has(item.image));
const total = String(items.length).padStart(2, '0');
---

<section id="trabajos" aria-labelledby="trabajos-titulo" data-works class="pb-20 pt-24 md:pb-28 md:pt-32">
	<div class="mx-auto w-full max-w-page px-5 md:px-10">
		<SectionHead index="04" label="Trabajos" title="Nuestros Trabajos" id="trabajos-titulo" />
	</div>

	<!-- Pinned on desktop when motion is allowed; otherwise a native scroll-snap strip. -->
	<div data-works-pin class="works-pin mt-12 md:mt-16">
		<div class="mx-auto flex w-full max-w-page items-baseline justify-between border-b border-rule px-5 pb-3 md:px-10">
			<p class="mono-label text-ink-2">Registro de campo</p>
			<p class="mono-label tabular-nums text-ink" aria-hidden="true"><span data-works-counter>01</span> / {total}</p>
		</div>

		<div
			data-works-viewport
			role="region"
			aria-label="Secuencia de fotos de trabajos, desplazable horizontalmente"
			tabindex="0"
			class="works-viewport snap-x snap-mandatory overflow-x-auto overscroll-x-contain"
		>
			<ul data-works-track class="works-track flex w-max gap-5 pt-6 md:gap-8">
				{
					items.map((item, i) => (
						<li data-works-frame class="shrink-0 snap-start">
							<figure>
								<button
									type="button"
									data-lightbox-open
									aria-label={`Ver foto: ${item.caption}`}
									class="block cursor-zoom-in"
								>
									<span class="works-frame relative block overflow-hidden bg-paper-2">
										<span data-works-img class="absolute inset-y-0 -left-[6%] block w-[112%]">
											<Photo
												image={item.image}
												alt={item.alt}
												widths={[480, 640, 734]}
												sizes="(min-width: 1024px) 52vh, (min-width: 768px) 46vw, 85vw"
												loading={i === 0 ? 'eager' : 'lazy'}
												class="h-full"
											/>
										</span>
									</span>
								</button>
								<figcaption class="mono-label mt-3 text-ink-2">FIG. {String(i + 7).padStart(2, '0')} — {item.caption}</figcaption>
							</figure>
						</li>
					))
				}
			</ul>
		</div>
	</div>

	<dialog id="lightbox" data-lightbox aria-label="Foto ampliada" class="m-auto max-h-[92svh] w-[min(92vw,720px)] border border-ink bg-paper p-0 text-ink backdrop:bg-ink/80">
		<form method="dialog" class="flex items-center justify-between border-b border-rule px-4 py-2">
			<p data-lightbox-caption class="mono-label text-ink-2"></p>
			<button class="mono-label py-2 pl-4 text-soil underline underline-offset-[6px]" autofocus>Cerrar</button>
		</form>
		<img data-lightbox-img alt="" class="block max-h-[78svh] w-full object-contain" />
	</dialog>
</section>

<style>
	.works-viewport {
		scrollbar-width: none;
		scroll-padding-inline: 1.25rem;
	}
	.works-viewport::-webkit-scrollbar {
		display: none;
	}
	.works-track {
		padding-inline: 1.25rem;
	}
	/* Portrait sources (734px wide): frames are sized by height on desktop to stay sharp. */
	.works-frame {
		width: 85vw;
		aspect-ratio: 3 / 4;
	}
	@media (min-width: 768px) {
		.works-viewport {
			scroll-padding-inline: 2.5rem;
		}
		.works-track {
			padding-inline: 2.5rem;
		}
		.works-frame {
			width: 46vw;
		}
	}
	@media (min-width: 1024px) {
		.works-frame {
			width: auto;
			height: min(70svh, calc(100svh - 14rem));
		}
		/* Leaves room for the last frame to travel to the centre of the viewport. */
		.works-track {
			padding-right: max(2.5rem, calc(50vw - 26svh));
		}
	}
	@media (min-width: 1320px) {
		.works-track {
			padding-left: calc((100vw - 1320px) / 2 + 2.5rem);
		}
	}
	/* Cinematic mode (set by motion.ts): the strip is translated, not scrolled. */
	:global(.works-pin.is-cinematic) {
		display: flex;
		height: 100svh;
		flex-direction: column;
		justify-content: center;
		padding-top: 5rem;
	}
	:global(.works-pin.is-cinematic) .works-viewport {
		overflow: hidden;
		scroll-snap-type: none;
	}
</style>

<script>
	const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
	const img = dialog?.querySelector<HTMLImageElement>('[data-lightbox-img]');
	const cap = dialog?.querySelector<HTMLElement>('[data-lightbox-caption]');
	let opener: HTMLElement | null = null;

	document.querySelectorAll<HTMLButtonElement>('[data-lightbox-open]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const photo = btn.querySelector('img');
			const figcap = btn.closest('figure')?.querySelector('figcaption');
			if (!dialog || !img || !photo) return;
			opener = btn;
			// Largest generated candidate from the srcset, falling back to the current source.
			const candidates = (photo.getAttribute('srcset') ?? '').split(',').map((c) => c.trim().split(' ')[0]).filter(Boolean);
			img.src = candidates[candidates.length - 1] ?? photo.currentSrc;
			img.alt = photo.alt;
			if (cap) cap.textContent = figcap?.textContent ?? '';
			dialog.showModal();
		});
	});

	dialog?.addEventListener('click', (e) => {
		if (e.target === dialog) dialog.close();
	});
	// Native <dialog> handles Esc; return focus to the opener on any close.
	dialog?.addEventListener('close', () => opener?.focus());
</script>
