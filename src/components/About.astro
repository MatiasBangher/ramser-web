---
import { business, mission, vision, values, valuesStatement } from '../data/site';
---

<section id="nosotros" aria-labelledby="nosotros-titulo" class="mx-auto w-full max-w-page px-5 pb-20 pt-20 md:px-10 md:pb-28 md:pt-28">
	<div data-rule class="h-px bg-ink/70"></div>
	<div class="grid grid-cols-12 gap-x-6 gap-y-10 pt-5">
		<div class="col-span-12 md:col-span-5">
			<div class="md:sticky md:top-28">
				<p class="mono-label text-ink-2">§ 02 — Nosotros</p>
				<h2 id="nosotros-titulo" data-split class="display mt-4 text-[clamp(2.25rem,5vw,4rem)] leading-[0.98]">Misión y Visión</h2>
			</div>
		</div>

		<div class="col-span-12 md:col-span-6 md:col-start-7">
			<div class="max-w-[34rem]">
				<h3 class="mono-label text-soil">{mission.title}</h3>
				<p class="mt-3">{mission.text}</p>
				<h3 class="mono-label mt-10 text-soil">{vision.title}</h3>
				<p class="mt-3">{vision.text}</p>
				<p class="mt-10 border-t border-rule pt-6 text-ink-2">{valuesStatement}</p>
			</div>
		</div>
	</div>

	<dl class="mt-16 grid grid-cols-1 border-t border-ink/70 md:mt-24 md:grid-cols-4">
		{
			values.map((v) => (
				<div class="border-b border-rule py-6 md:border-b-0 md:border-l md:border-rule md:px-6 md:first:border-l-0 md:first:pl-0">
					<dt class="display text-[2rem] leading-none">{v.title}</dt>
					<dd class="mt-3 text-ink-2">{v.text}</dd>
				</div>
			))
		}
	</dl>

	<div class="mt-16 grid grid-cols-12 gap-x-6 md:mt-24">
		<div class="col-span-12 md:col-span-6 md:col-start-7">
			<div data-stamp class="inline-block border border-soil p-1 md:-rotate-2">
				<div class="border border-soil px-5 py-4 text-soil">
					<p class="mono-label font-medium">Habilitación Provincial N°{business.license.number}</p>
					<p class="mono-label mt-1">Ministerio de Salud — Provincia del Chaco</p>
				</div>
			</div>
		</div>
	</div>
</section>
