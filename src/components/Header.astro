            <button id="mobile-menu-button" 
                    class="md:hidden relative inline-flex items-center justify-center w-10 h-10 rounded-lg text-gray-300 hover:text-green-400 hover:bg-green-900/20 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2 focus:ring-offset-gray-950 transition-all duration-300"
                    onclick="toggleMobileMenu(event)"
                    aria-expanded="false"
                    aria-controls="mobile-menu"
                    aria-label="Abrir menú de navegación">
