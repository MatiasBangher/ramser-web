---
import { business, nav, waLink } from '../data/site';
---

<header
	id="top"
	data-header
	class="fixed inset-x-0 top-0 z-50 border-b border-rule bg-paper transition-[border-color] duration-300 motion-reduce:transition-none"
>
	<div data-header-row class="mx-auto flex h-16 w-full max-w-page items-center justify-between gap-6 px-5 transition-[height] duration-300 motion-reduce:transition-none md:px-10 lg:h-20">
		<a href="#inicio" class="flex items-center gap-3" aria-label={`${business.name} - Inicio`}>
			<img src="/logo.png" width="642" height="389" alt="" class="h-8 w-auto lg:h-10" />
			<span class="flex flex-col leading-tight">
				<span class="font-sans text-base font-medium tracking-tight text-ink">{business.name}</span>
				<span class="mono-label hidden text-ink-2 sm:block">Saneamiento ambiental</span>
			</span>
		</a>

		<nav aria-label="Principal" class="mono-label hidden items-center gap-7 lg:flex">
			{
				nav.map((item) => (
					<a href={item.href} class="py-2 text-ink-2 underline-offset-[6px] hover:text-soil hover:underline">
						{item.label}
					</a>
				))
			}
		</nav>

		<div class="flex items-center gap-5">
			<p class="mono-label hidden border border-soil px-2.5 py-1.5 text-soil xl:block">Hab. Prov. N°{business.license.number}</p>
			<a
				href={waLink('header')}
				target="_blank"
				rel="noopener noreferrer"
				class="mono-label hidden py-2 text-ink underline decoration-soil decoration-1 underline-offset-[6px] hover:text-soil lg:inline-block"
			>
				WhatsApp →
			</a>
			<button
				type="button"
				data-menu-button
				aria-expanded="false"
				aria-controls="menu-movil"
				class="mono-label -mr-2 inline-flex h-11 items-center px-2 text-ink lg:hidden"
			>
				<span data-menu-label>Menú</span>
			</button>
		</div>
	</div>

	<div id="menu-movil" data-menu hidden class="fixed inset-x-0 bottom-0 top-16 overflow-y-auto border-t border-rule bg-paper lg:hidden">
		<nav aria-label="Móvil" class="mx-auto flex min-h-full w-full max-w-page flex-col px-5 pb-10 pt-4">
			{
				nav.map((item) => (
					<a href={item.href} class="display border-b border-rule py-4 text-[2.5rem] leading-none text-ink hover:text-soil">
						{item.label}
					</a>
				))
			}
			<a
				href={waLink('header')}
				target="_blank"
				rel="noopener noreferrer"
				class="mono-label mt-8 py-3 text-ink underline decoration-soil decoration-1 underline-offset-[6px]"
			>
				WhatsApp {business.phoneDisplay} →
			</a>
			<p class="mono-label mt-auto pt-10 text-soil">Hab. Prov. N°{business.license.number}</p>
		</nav>
	</div>
</header>

<style is:global>
	[data-header].is-scrolled {
		border-bottom-color: rgba(27, 29, 24, 0.55);
	}
	[data-header].is-scrolled [data-header-row] {
		height: 3.25rem;
	}
	@media (min-width: 1024px) {
		[data-header].is-scrolled [data-header-row] {
			height: 3.5rem;
		}
	}
	[data-header].is-scrolled [data-menu] {
		top: 3.25rem;
	}
</style>

<script>
	const button = document.querySelector<HTMLButtonElement>('[data-menu-button]');
	const menu = document.querySelector<HTMLElement>('[data-menu]');
	const label = document.querySelector<HTMLElement>('[data-menu-label]');
	const header = document.querySelector<HTMLElement>('[data-header]');

	function isOpen() {
		return button?.getAttribute('aria-expanded') === 'true';
	}

	function setOpen(open: boolean, returnFocus = false) {
		if (!button || !menu) return;
		menu.hidden = !open;
		button.setAttribute('aria-expanded', String(open));
		if (label) label.textContent = open ? 'Cerrar' : 'Menú';
		document.documentElement.classList.toggle('menu-open', open);
		if (!open && returnFocus) button.focus();
		if (open) menu.querySelector<HTMLElement>('a')?.focus();
	}

	button?.addEventListener('click', () => setOpen(!isOpen()));
	menu?.addEventListener('click', (e) => {
		if ((e.target as HTMLElement).closest('a')) setOpen(false);
	});
	document.addEventListener('keydown', (e) => {
		if (!isOpen()) return;
		if (e.key === 'Escape') {
			setOpen(false, true);
			return;
		}
		// Focus trap-lite: keep Tab cycling between the toggle and the menu links.
		if (e.key === 'Tab' && header && menu && button) {
			const items = [button, ...Array.from(menu.querySelectorAll<HTMLElement>('a[href]'))];
			const first = items[0];
			const last = items[items.length - 1];
			const active = document.activeElement;
			if (e.shiftKey && active === first) {
				e.preventDefault();
				last.focus();
			} else if (!e.shiftKey && active === last) {
				e.preventDefault();
				first.focus();
			}
		}
	});
	window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
		if (e.matches) setOpen(false);
	});
</script>
