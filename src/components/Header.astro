                    <img src="/logo.png" class="h-10 w-10 lg:h-14 lg:w-14 transition-transform duration-300 group-hover:scale-110 object-contain" alt="RAMSER S.A.S Logo" />
                    <div class="absolute inset-0 bg-green-500 rounded-lg opacity-0 group-hover:opacity-20 transition-opacity duration-300"></div>
                </div>
                <div class="flex flex-col">
                    <span class="text-lg lg:text-xl font-bold text-white group-hover:text-green-400 transition-colors duration-300">RAMSER S.A.S</span>
                    <span class="text-xs lg:text-sm text-green-400 font-medium">Saneamiento Ambiental</span>
                </div>
            </a>

            <!-- Desktop Navigation -->
            <nav class="hidden md:flex items-center space-x-8" role="navigation" aria-label="Navegación principal">
                <a href="/" class="nav-link text-gray-300 hover:text-green-400 font-medium transition-colors duration-300 relative group">
                    Inicio
