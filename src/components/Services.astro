---
import Photo from './Photo.astro';
import SectionHead from './SectionHead.astro';
import { services, scope } from '../data/site';
---

<section id="servicios" aria-labelledby="servicios-titulo" class="mx-auto w-full max-w-page px-5 pb-20 pt-16 md:px-10 md:pb-28 md:pt-28">
	<SectionHead index="01" label="Servicios" title="Nuestros Servicios" id="servicios-titulo" />

	<ul class="mt-12 md:mt-20">
		{
			services.map((s, i) => (
				<li class="group relative border-t border-rule last:border-b">
					<span class="absolute left-0 top-0 hidden h-full w-[3px] origin-top scale-y-0 bg-soil transition-transform duration-300 group-hover:scale-y-100 motion-reduce:transition-none md:block" aria-hidden="true" />
					<div class="grid grid-cols-12 items-start gap-x-6 gap-y-5 py-8 md:py-10 md:pl-4">
						<p class="mono-label col-span-2 pt-2 text-ink-2 md:col-span-1" aria-hidden="true">N° {String(i + 1).padStart(2, '0')}</p>
						<h3 class="display col-span-10 text-[2rem] leading-none md:col-span-3 md:text-[2.5rem]">{s.title}</h3>
						<p class="col-span-12 text-ink-2 md:col-span-5 md:col-start-5">
							{s.body} <strong class="font-semibold text-ink">{s.highlight}</strong>{s.tail}
						</p>
						<figure class="col-span-12 overflow-hidden md:col-span-3 md:col-start-10">
							<Photo
								image={s.image}
								alt={s.alt}
								widths={[320, 480, 640]}
								sizes="(min-width: 768px) 25vw, calc(100vw - 2.5rem)"
								class="aspect-[4/3] transition-transform duration-500 group-hover:scale-[1.02] motion-reduce:transition-none"
							/>
							<figcaption class="mono-label mt-2 text-ink-2">FIG. {String(i + 2).padStart(2, '0')} — {s.caption}</figcaption>
						</figure>
					</div>
				</li>
			))
		}
	</ul>

	<dl class="mt-10 grid grid-cols-12 gap-x-6 gap-y-3 border-t border-ink/70 pt-5">
		<dt class="mono-label col-span-12 text-ink-2 md:col-span-2">{scope.label}</dt>
		<dd class="col-span-12 md:col-span-9">
			<span class="display text-[1.75rem] leading-tight md:text-[2rem]">Plagas {scope.kinds.toLowerCase()}</span>
			<span class="mono-label mt-2 block text-ink-2">{scope.places.join(' · ')}</span>
		</dd>
	</dl>
</section>
