---
import GalleryItems from './GalleryItems.astro'
---

<!-- Section Header -->
<div class="relative text-center pt-20 pb-16" id="gallery-header">
    <div class="inline-flex items-center px-4 py-2 bg-green-600/20 border border-green-500/30 rounded-full text-green-300 text-sm font-medium mb-6" id="gallery-badge">
        <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd"/>
        </svg>
        Portafolio de Trabajos
    </div>
    <h1 class="text-4xl md:text-6xl font-bold text-white mb-6" id="gallery-title">
        Nuestros <span class="text-green-400">Trabajos</span>
    </h1>
    <p class="text-xl text-gray-300 max-w-3xl mx-auto leading-relaxed" id="gallery-subtitle">
        Descubre algunos de nuestros proyectos más destacados en control de plagas 
        y saneamiento ambiental en la región NEA.
    </p>
</div>

<section
    class={`
    w-full max-w-[1400px]
    grid grid-cols-9 auto-rows-[12rem] md:auto-rows-[16rem] gap-3 md:gap-4 
    mx-auto pl-4 pr-4 pt-8 md:pl-8 md:pr-8 md:pt-10
    pb-12 md:pb-16
    animate-fade-in
    `}
    id="Nuestros-Trabajos"
    >
    <GalleryItems class="col-span-9 md:col-span-3" id="gallery-item-1">
        <div 
            slot="image" 
            class="absolute left-0 top-0 bottom-0 w-full h-full
            group-hover:scale-110 transition-scale duration-1000 ease-in-out opacity-90
            bg-blend-luminosity bg-left bg-cover bg-no-repeat z-0"
            style="background-image: url('/fum2.webp')"
        >
        </div>
    </GalleryItems>
    <GalleryItems class="col-span-9 md:col-span-3" id="gallery-item-2">
        <div 
            slot="image" 
            class="absolute left-0 top-0 bottom-0 w-full h-full
            group-hover:scale-110 transition-scale duration-1000 ease-in-out opacity-90
            bg-blend-luminosity bg-left bg-cover bg-no-repeat z-0"
            style="background-image: url('/trab2.webp')"
        >
        </div>
    </GalleryItems>
    <GalleryItems class="col-span-9 md:col-span-3" id="gallery-item-3">
        <div 
            slot="image" 
            class="absolute left-0 top-0 bottom-0 w-full h-full
            group-hover:scale-110 transition-scale duration-1000 ease-in-out opacity-90
            bg-blend-luminosity bg-left bg-cover bg-no-repeat z-0"
            style="background-image: url('/fumigando.webp')"
        >
        </div>
    </GalleryItems>
    <GalleryItems class="col-span-9 md:col-span-3" id="gallery-item-4">
        <div 
            slot="image" 
            class="absolute left-0 top-0 bottom-0 w-full h-full
            group-hover:scale-110 transition-scale duration-1000 ease-in-out opacity-90
            bg-blend-luminosity bg-left bg-cover bg-no-repeat z-0"
            style="background-image: url('/trab3.webp')"
        >
        </div>
    </GalleryItems>
    <GalleryItems class="col-span-9 md:col-span-3" id="gallery-item-5">
        <div 
            slot="image" 
            class="absolute left-0 top-0 bottom-0 w-full h-full
            group-hover:scale-110 transition-scale duration-1000 ease-in-out opacity-90
            bg-blend-luminosity bg-left bg-cover bg-no-repeat z-0"
            style="background-image: url('/trab4.webp')"
        >
        </div>
    </GalleryItems>
    <GalleryItems class="col-span-9 md:col-span-3" id="gallery-item-6">
        <div 
            slot="image" 
            class="absolute left-0 top-0 bottom-0 w-full h-full
            group-hover:scale-110 transition-scale duration-1000 ease-in-out opacity-90
            bg-blend-luminosity bg-left bg-cover bg-no-repeat z-0"
            style="background-image: url('/trab5.webp')"
        >
        </div>
    </GalleryItems>

</section>

<!-- Call to Action -->
<div class="text-center mt-16 mb-20" id="gallery-cta">
    <div class="bg-gradient-to-r from-green-600/20 to-green-500/20 border border-green-500/30 rounded-2xl p-8 backdrop-blur-sm max-w-2xl mx-auto">
        <h3 class="text-2xl font-bold text-white mb-4">¿Necesitas Nuestros Servicios?</h3>
        <p class="text-gray-300 mb-6">
            Contáctanos para obtener una evaluación personalizada y un presupuesto 
            adaptado a tus necesidades específicas.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
                               <a href="https://wa.me/543644598253?text=Hola,%20me%20interesa%20conocer%20más%20sobre%20sus%20servicios"
                      class="inline-flex items-center justify-center px-6 py-3 bg-green-600 text-white font-semibold rounded-lg hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2 transition-all duration-300 transform hover:scale-105"
               rel="noopener">
                <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.488"/>
                </svg>
                Solicitar Presupuesto
            </a>
            <a href="tel:+543644598253" 
               class="inline-flex items-center justify-center px-6 py-3 bg-transparent text-white font-semibold rounded-lg border-2 border-white/30 hover:border-white/60 hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white/50 focus:ring-offset-2 transition-all duration-300 transform hover:scale-105">
                <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
                </svg>
                Llamar Ahora
            </a>
        </div>
    </div>
</div>

<script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    
    gsap.registerPlugin(ScrollTrigger);

    // Gallery header animations
    const galleryHeaderTl = gsap.timeline({
        scrollTrigger: {
            trigger: "#gallery-header",
            start: "top 80%",
            end: "bottom 20%",
            toggleActions: "play none none reverse"
        }
    });

    galleryHeaderTl.from("#gallery-badge", {
        y: -30,
        opacity: 0,
        duration: 0.8,
        ease: "power2.out"
    })
    .from("#gallery-title", {
        y: 30,
        opacity: 0,
        duration: 0.8,
        ease: "power2.out"
    }, "-=0.4")
    .from("#gallery-subtitle", {
        y: 30,
        opacity: 0,
        duration: 0.8,
        ease: "power2.out"
    }, "-=0.6");

    // Gallery grid animations - cada item con su propio ScrollTrigger
    document.querySelectorAll('#gallery-item-1, #gallery-item-2, #gallery-item-3, #gallery-item-4, #gallery-item-5, #gallery-item-6').forEach((el) => {
        gsap.from(el as Element, {
            y: 50,
            opacity: 0,
            duration: 0.8,
            ease: "power2.out",
            immediateRender: false,
            scrollTrigger: {
                trigger: el as Element,
                start: "top 85%",
                end: "bottom 15%",
                toggleActions: "play none none reverse"
            }
        });
    });

    // CTA animation
    gsap.fromTo("#gallery-cta",
        { scale: 0.9, opacity: 0 },
        {
            scale: 1,
            opacity: 1,
            duration: 1,
            ease: "back.out(1.7)",
            scrollTrigger: {
                trigger: "#gallery-cta",
                start: "top 80%",
                end: "bottom 20%",
                toggleActions: "play none none reverse"
            }
        }
    );

    // Hover animations for gallery items - Same as Bento services
    document.querySelectorAll('#gallery-item-1, #gallery-item-2, #gallery-item-3, #gallery-item-4, #gallery-item-5, #gallery-item-6').forEach(item => {
        item.addEventListener('mouseenter', () => {
            gsap.to(item, {
                scale: 1.02,
                duration: 0.3,
                ease: "power2.out"
            });
        });

        item.addEventListener('mouseleave', () => {
            gsap.to(item, {
                scale: 1,
                duration: 0.3,
                ease: "power2.out"
            });
        });
    });

    // Parallax effect for gallery images
    const galleryImages = document.querySelectorAll('#Nuestros-Trabajos div[slot="image"]');
    galleryImages.forEach(img => {
        gsap.to(img, {
            yPercent: -10,
            ease: "none",
            scrollTrigger: {
                trigger: img,
                start: "top bottom",
                end: "bottom top",
                scrub: true
            }
        });
    });
</script>