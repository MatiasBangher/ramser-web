---
import BentoItem from './BentoItem.astro'
---

<!-- Section Header -->
<div class="relative text-center pt-20 pb-16" id="services-header">
    <div class="inline-flex items-center px-4 py-2 bg-green-600/20 border border-green-500/30 rounded-full text-green-300 text-sm font-medium mb-6" id="services-badge">
        <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"/>
        </svg>
        Servicios Profesionales
    </div>
    <h1 class="text-4xl md:text-6xl font-bold text-white mb-6" id="services-title">
        Nuestros <span class="text-green-400">Servicios</span>
    </h1>
    <p class="text-xl text-gray-300 max-w-3xl mx-auto leading-relaxed" id="services-subtitle">
        Ofrecemos soluciones integrales de control de plagas y saneamiento ambiental 
        con la más alta tecnología y profesionales certificados.
    </p>
</div>

<section
    class={`
    w-full max-w-[1400px]
    grid grid-cols-10 auto-rows-[12rem] md:auto-rows-[16rem] gap-3 md:gap-4 
    mx-auto pl-4 pr-4 pt-8 md:pl-8 md:pr-8 md:pt-10
    animate-fade-in
    `}
    id="Servicios"
    >
    <BentoItem class="col-span-10 md:col-span-4" title="Control de Plagas" id="service-1">
        <div 
            slot="image" 
            class="absolute left-0 top-0 bottom-0 w-full h-full
            group-hover:scale-110 transition-scale duration-1000 ease-in-out opacity-90
            bg-blend-luminosity bg-left bg-cover bg-no-repeat z-0"
            style="background-image: url('/cl.webp')"
        >
        </div>
        <p slot="content" class="max-w-xl text-base lg:text-xl">
            Aplicamos tratamientos con la tecnología más reciente mediante el concepto de 
            <strong class="text-green-400">Gestión Integrada de Plagas (M.I.P)</strong>, 
            eliminando problemas con mínimo impacto ambiental.
        </p>
    </BentoItem>
    <BentoItem class="col-span-10 md:col-span-6" title="Control de Roedores" id="service-2">
            <div 
            slot="image" 
            class="absolute left-0 top-0 bottom-0 w-full h-full
            group-hover:scale-110 transition-scale duration-1000 ease-in-out opacity-90
            bg-blend-luminosity bg-left bg-cover bg-no-repeat z-0"
            style="background-image: url('/ratita.webp')"
        >
        </div>
        <p slot="content" class="max-w-xl text-base lg:text-xl">
            Nuestros servicios garantizan protección con soluciones eficaces y seguras. 
            Realizamos tratamientos en <strong class="text-green-400">comercios, fábricas, 
            plantas de acopio, almacenes</strong> y cualquier tipo de instalación.
        </p>
    </BentoItem>
    <BentoItem class="col-span-10 md:col-span-6" title="Saneamiento Ambiental" id="service-3">
        <div 
            slot="image" 
            class="absolute left-0 top-0 bottom-0 w-full h-full
            group-hover:scale-110 transition-scale duration-1000 ease-in-out opacity-90
            bg-blend-luminosity bg-left bg-cover bg-no-repeat z-0"
            style="background-image: url('/saneando.webp')"
        >
        </div>
        <p slot="content" class="max-w-xl text-base lg:text-xl">
            Nuestros servicios abarcan el control de la contaminación y la prevención 
            de enfermedades transmitidas por el medio ambiente con <strong class="text-green-400">
            métodos seguros y certificados</strong>.
        </p>
    </BentoItem>
    <BentoItem class="col-span-10 md:col-span-4" title="Equipos y Tecnología" id="service-4">
        <div 
            slot="image" 
            class="absolute left-0 top-0 bottom-0 w-full h-full
            group-hover:scale-110 transition-scale duration-1000 ease-in-out opacity-90
            bg-blend-luminosity bg-left bg-cover bg-no-repeat z-0"
            style="background-image: url('/fumigando.webp')"
        >
        </div>
        <p slot="content" class="max-w-xl text-base lg:text-xl">
            Contamos con un equipo de profesionales altamente capacitados que utilizan 
            la última tecnología y los mejores productos. <strong class="text-green-400">
            Tu tranquilidad y protección son nuestra prioridad</strong>.
        </p>
    </BentoItem>

</section>

<div class="animate-pop animate-on-scroll flex justify-center pt-8" id="certification-badge">
    <div class="max-w-lg rounded bg-gradient-to-r from-green-600/20 to-green-500/20 border border-green-500/30 backdrop-blur-sm overflow-hidden shadow-lg">
        <div class="px-6 py-4">
            <div class="font-bold text-base text-center lg:text-2xl mb-2 text-white">HABILITACIÓN PROVINCIAL N°2952</div>
            <p class="text-green-300 text-sm text-center lg:text-base">
                Ministerio de Salud - Provincia del Chaco
            </p>
        </div>    
    </div>
</div>

<div class="text-center text-base md:text-2xl pt-20 m-0 font-family pb-10" id="values-section">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 max-w-4xl mx-auto">
        <div class="text-center group" id="value-1">
            <div class="w-16 h-16 bg-green-500/20 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:bg-green-500/30 transition-colors duration-300">
                <svg class="w-8 h-8 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-8.293l-3-3a1 1 0 00-1.414 0l-3 3a1 1 0 001.414 1.414L9 9.414V13a1 1 0 102 0V9.414l1.293 1.293a1 1 0 001.414-1.414z" clip-rule="evenodd"/>
                </svg>
            </div>
            <h4 class="text-xl font-bold text-white mb-2">Rapidez</h4>
            <p class="text-gray-300 text-sm">Respuesta inmediata a sus necesidades</p>
        </div>
        <div class="text-center group" id="value-2">
            <div class="w-16 h-16 bg-green-500/20 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:bg-green-500/30 transition-colors duration-300">
                <svg class="w-8 h-8 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"/>
                </svg>
            </div>
            <h4 class="text-xl font-bold text-white mb-2">Eficacia</h4>
            <p class="text-gray-300 text-sm">Resultados garantizados en cada servicio</p>
        </div>
        <div class="text-center group" id="value-3">
            <div class="w-16 h-16 bg-green-500/20 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:bg-green-500/30 transition-colors duration-300">
                <svg class="w-8 h-8 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
            </div>
            <h4 class="text-xl font-bold text-white mb-2">Disciplina</h4>
            <p class="text-gray-300 text-sm">Metodología rigurosa y profesional</p>
        </div>
        <div class="text-center group" id="value-4">
            <div class="w-16 h-16 bg-green-500/20 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:bg-green-500/30 transition-colors duration-300">
                <svg class="w-8 h-8 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/>
                </svg>
            </div>
            <h4 class="text-xl font-bold text-white mb-2">Confianza</h4>
            <p class="text-gray-300 text-sm">Relaciones duraderas con nuestros clientes</p>
        </div>
    </div>
</div>

<!-- Misión, Visión y Valores Section -->
<section class="relative py-10 bg-gradient-to-br from-gray-950 via-gray-900 to-green-950" id="mision-vision-valores">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Section Header -->
        <div class="text-center mb-16">
            <div class="inline-flex items-center px-4 py-2 bg-green-600/20 border border-green-500/30 rounded-full text-green-300 text-sm font-medium mb-6">
                <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M3 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"/>
                </svg>
                Nuestra Identidad
            </div>
            <h2 class="text-3xl md:text-5xl font-bold text-white mb-6">
                Misión, <span class="text-green-400">Visión</span> y Valores
            </h2>
            <p class="text-xl text-gray-300 max-w-3xl mx-auto">
                Los pilares que guían nuestro compromiso con la excelencia y el servicio profesional
            </p>
        </div>

        <!-- Cards Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12">
            <!-- Misión Card -->
            <div class="bg-gray-900/50 border border-green-500/30 rounded-2xl p-8 hover:border-green-400/50 transition-all duration-300" id="mision-card">
                <!-- Number Badge -->
                <div class="inline-flex items-center justify-center w-12 h-12 bg-green-500/20 rounded-full mb-6">
                    <span class="text-2xl font-bold text-green-400">01</span>
                </div>
                
                <!-- Title -->
                <h3 class="text-2xl font-bold text-white mb-4">
                    MISIÓN
                </h3>
                
                <!-- Divider -->
                <div class="w-16 h-0.5 bg-green-500/50 mb-6"></div>
                
                <!-- Content -->
                <p class="text-gray-300 leading-relaxed text-lg">
                    Contribuir a la salud de nuestros clientes y el medio ambiente, 
                    solucionando rápida y efectivamente los problemas de plagas urbanas, 
                    rurales e industriales, así como prevenir nuevas infestaciones, 
                    ofreciendo servicios de control profesional y productos de calidad 
                    para su control.
                </p>
            </div>

            <!-- Valores Card -->
            <div class="bg-gray-900/50 border border-green-500/30 rounded-2xl p-8 hover:border-green-400/50 transition-all duration-300" id="valores-card">
                <!-- Number Badge -->
                <div class="inline-flex items-center justify-center w-12 h-12 bg-green-500/20 rounded-full mb-6">
                    <span class="text-2xl font-bold text-green-400">02</span>
                </div>
                
                <!-- Title -->
                <h3 class="text-2xl font-bold text-white mb-4">
                    VALORES
                </h3>
                
                <!-- Divider -->
                <div class="w-16 h-0.5 bg-green-500/50 mb-6"></div>
                
                <!-- Content -->
                <p class="text-gray-300 leading-relaxed text-lg">
                    Compromiso, honestidad y disciplina que creemos que todos nuestros 
                    clientes merecen, con los cuales creamos una relación de confianza 
                    para solucionar sus problemas de la mejor manera para que sigan 
                    confiando en nosotros.
                </p>
            </div>

            <!-- Visión Card -->
            <div class="bg-gray-900/50 border border-green-500/30 rounded-2xl p-8 hover:border-green-400/50 transition-all duration-300" id="vision-card">
                <!-- Number Badge -->
                <div class="inline-flex items-center justify-center w-12 h-12 bg-green-500/20 rounded-full mb-6">
                    <span class="text-2xl font-bold text-green-400">03</span>
                </div>
                
                <!-- Title -->
                <h3 class="text-2xl font-bold text-white mb-4">
                    VISIÓN
                </h3>
                
                <!-- Divider -->
                <div class="w-16 h-0.5 bg-green-500/50 mb-6"></div>
                
                <!-- Content -->
                <p class="text-gray-300 leading-relaxed text-lg">
                    Nos proponemos ser la empresa líder en el mercado en la prestación 
                    de servicios, gestión y control de plagas, buscando siempre la 
                    confianza de nuestros clientes y proveedores, basándonos en la 
                    experiencia y profesionalismo de nuestro equipo.
                </p>
            </div>
        </div>

        <!-- Bottom CTA -->
        <div class="text-center mt-16">
            <div class="inline-flex items-center px-6 py-3 bg-green-600/20 border border-green-500/30 rounded-full text-green-300 text-sm font-medium backdrop-blur-sm">
                <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                Comprometidos con la Excelencia
            </div>
        </div>
    </div>
</section>

<script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    
    gsap.registerPlugin(ScrollTrigger);

    // Services section animations
    const servicesTl = gsap.timeline({
        scrollTrigger: {
            trigger: "#services-header",
            start: "top 80%",
            end: "bottom 20%",
            toggleActions: "play none none reverse"
        }
    });

    servicesTl.from("#services-badge", {
        y: -30,
        opacity: 0,
        duration: 0.8,
        ease: "power2.out"
    })
    .from("#services-title", {
        y: 30,
        opacity: 0,
        duration: 0.8,
        ease: "power2.out"
    }, "-=0.4")
    .from("#services-subtitle", {
        y: 30,
        opacity: 0,
        duration: 0.8,
        ease: "power2.out"
    }, "-=0.6");

    // Services grid animations
    const servicesGridTl = gsap.timeline({
        scrollTrigger: {
            trigger: "#Servicios",
            start: "top 80%",
            end: "bottom 20%",
            toggleActions: "play none none reverse"
        }
    });

    servicesGridTl.from("#service-1", {
        y: 50,
        opacity: 0,
        duration: 0.8,
        ease: "power2.out"
    })
    .from("#service-2", {
        y: 50,
        opacity: 0,
        duration: 0.8,
        ease: "power2.out"
    }, "-=0.6")
    .from("#service-3", {
        y: 50,
        opacity: 0,
        duration: 0.8,
        ease: "power2.out"
    }, "-=0.6")
    .from("#service-4", {
        y: 50,
        opacity: 0,
        duration: 0.8,
        ease: "power2.out"
    }, "-=0.6");

    // Certification badge animation
    gsap.fromTo("#certification-badge",
        { scale: 0.8, opacity: 0 },
        {
            scale: 1,
            opacity: 1,
            duration: 1,
            ease: "back.out(1.7)",
            scrollTrigger: {
                trigger: "#certification-badge",
                start: "top 80%",
                end: "bottom 20%",
                toggleActions: "play none none reverse"
            }
        }
    );

    // Values animation
    gsap.fromTo(["#value-1", "#value-2", "#value-3", "#value-4"],
        { y: 30, opacity: 0 },
        {
            y: 0,
            opacity: 1,
            duration: 0.8,
            stagger: 0.1,
            ease: "power2.out",
            scrollTrigger: {
                trigger: "#values-section",
                start: "top 80%",
                end: "bottom 20%",
                toggleActions: "play none none reverse"
            }
        }
    );

    // Misión, Visión y Valores animations - DISABLED TO FIX VISIBILITY ISSUE
    // const misionVisionTl = gsap.timeline({
    //     scrollTrigger: {
    //         trigger: "#mision-vision-valores",
    //         start: "top 80%",
    //         end: "bottom 20%",
    //         toggleActions: "play none none none"
    //     }
    // });

    // misionVisionTl.from("#mision-card", {
    //     y: 50,
    //     opacity: 0,
    //     duration: 0.8,
    //     ease: "power2.out"
    // })
    // .from("#valores-card", {
    //     y: 50,
    //     opacity: 0,
    //     duration: 0.8,
    //     ease: "power2.out"
    // }, "-=0.4")
    // .from("#vision-card", {
    //     y: 50,
    //     opacity: 0,
    //     duration: 0.8,
    //     ease: "power2.out"
    // }, "-=0.4");

    // Hover animations for service cards
    document.querySelectorAll('#service-1, #service-2, #service-3, #service-4').forEach(card => {
        card.addEventListener('mouseenter', () => {
            gsap.to(card, {
                scale: 1.02,
                duration: 0.3,
                ease: "power2.out"
            });
        });

        card.addEventListener('mouseleave', () => {
            gsap.to(card, {
                scale: 1,
                duration: 0.3,
                ease: "power2.out"
            });
        });
    });

    // Hover animations for mission/vision cards - DISABLED TO FIX VISIBILITY ISSUE
    // document.querySelectorAll('#mision-card, #valores-card, #vision-card').forEach(card => {
    //     card.addEventListener('mouseenter', () => {
    //         gsap.to(card, {
    //             scale: 1.02,
    //             duration: 0.3,
    //             ease: "power2.out"
    //         });
    //     });

    //     card.addEventListener('mouseleave', () => {
    //         gsap.to(card, {
    //             scale: 1,
    //             duration: 0.3,
    //             ease: "power2.out"
    //         });
    //     });
    // });
</script>