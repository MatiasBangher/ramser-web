---
interface Props{
    class?:string
    title:string
    id?:string
}

const {title, id} = Astro.props
---
<article class={`
    ${Astro.props.class}
    relative rounded-2xl
    blackdrop-blur-md
    border border-black/10
    shadow-inner shadow-white/10
    overflow-hidden
    group
`}
id={id}
>
    <div class="absolute z-10 bottom-0 top-0 w-full h-full
    bg-gradient-to-b from-transparent from-30 via-black/40 to-black/85"></div>
    <slot name = "image"/>
    
    <div class="relative select-none flex flex-col gap-1 p-4 md:p-6 text-base z-20 justify-end h-full">
        <div class="bg-black/45 backdrop-blur-sm rounded-lg p-3 md:p-4 ring-1 ring-white/10">
            {title && <h2 class="text-lg md:text-2xl font-bold text-balance text-white drop-shadow-md mb-2">{title}</h2>}
            <div class="text-white/90 drop-shadow-sm text-sm md:text-base">
                <slot name = "content"/>
            </div>
        </div>
    </div>
    
</article>