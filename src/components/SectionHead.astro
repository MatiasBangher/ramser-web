---
interface Props {
	index: string;
	label: string;
	title: string;
	id: string;
	dark?: boolean;
}
const { index, label, title, id, dark = false } = Astro.props;
---

<div>
	<div data-rule class:list={['h-px', dark ? 'bg-paper/60' : 'bg-ink/70']}></div>
	<div class="grid grid-cols-12 gap-x-6 gap-y-4 pt-5">
		<p class:list={['mono-label col-span-12 md:col-span-2 md:pt-4', dark ? 'text-paper/75' : 'text-ink-2']}>§ {index} — {label}</p>
		<h2 id={id} data-split class="display col-span-12 text-[clamp(2.25rem,5vw,4rem)] leading-[0.98] md:col-span-9">{title}</h2>
	</div>
</div>
