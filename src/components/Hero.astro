---
---

<section class="relative h-screen flex items-center justify-center overflow-hidden bg-gradient-to-br from-gray-950 via-gray-900 to-green-950">
    <!-- Background Elements -->
    <div class="absolute inset-0">
        <!-- Animated background pattern -->
        <div class="absolute inset-0 opacity-10">
            <div class="absolute top-0 left-0 w-full h-full bg-gradient-to-br from-green-500/5 to-transparent animate-pulse"></div>
        </div>
        
        <!-- Hero background image with overlay -->
        <div class="absolute inset-0">
                         <img 
                 src="/hero1.webp" 
                 alt="RAMSER S.A.S - Control de Plagas" 
                 class="w-full h-full object-cover object-center opacity-20 scale-[1.2]"
                 style="clip-path: polygon(0 0, 100% 0, 100% 85%, 50% 100%, 0 85%);"
                 id="hero-bg"
             />
                         <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/60 to-transparent"></div>
        </div>
        
        <!-- Floating elements -->
        <div class="absolute top-20 left-10 w-20 h-20 bg-green-500/20 rounded-full blur-xl animate-pulse" id="floating-1"></div>
        <div class="absolute top-40 right-20 w-32 h-32 bg-green-400/10 rounded-full blur-xl animate-pulse delay-1000" id="floating-2"></div>
        <div class="absolute bottom-20 left-1/4 w-16 h-16 bg-green-300/20 rounded-full blur-xl animate-pulse delay-2000" id="floating-3"></div>
    </div>

    <!-- Main Content -->
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
            <!-- Left Column - Text Content -->
            <div class="text-left space-y-8" id="hero-content">
                <!-- Badge -->
                <div class="inline-flex items-center px-4 py-2 bg-green-600/20 border border-green-500/30 rounded-full text-green-300 text-sm font-medium backdrop-blur-sm" id="hero-badge">
                    <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                    </svg>
                    Habilitación Provincial N°2952
                </div>

                <!-- Main Heading -->
                <div class="space-y-4">
                    <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold text-white leading-tight" id="hero-title">
                        <span class="block">RAMSER</span>
                        <span class="block text-green-400">S.A.S</span>
                        <span class="block text-2xl md:text-3xl lg:text-4xl text-green-300 font-medium mt-4">SANEAMIENTO AMBIENTAL</span>
                    </h1>
                </div>

                <!-- Description -->
                <p class="text-lg md:text-xl text-gray-300 leading-relaxed max-w-2xl" id="hero-description">
                    Sociedad especializada en <strong class="text-green-400">sanidad ambiental</strong> y 
                    <strong class="text-green-400">control de plagas</strong> en la región NEA, con domicilio en 
                    <strong class="text-green-400">Pampa del Infierno, Chaco</strong>. 
                    Ofrecemos soluciones profesionales con la más alta calidad y tecnología.
                </p>

                <!-- Features -->
                <div class="grid grid-cols-2 gap-4 max-w-md" id="hero-features">
                    <div class="flex items-center space-x-3 text-green-300">
                        <svg class="w-5 h-5 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                        </svg>
                        <span class="text-sm font-medium">Rapidez</span>
                    </div>
                    <div class="flex items-center space-x-3 text-green-300">
                        <svg class="w-5 h-5 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                        </svg>
                        <span class="text-sm font-medium">Eficacia</span>
                    </div>
                    <div class="flex items-center space-x-3 text-green-300">
                        <svg class="w-5 h-5 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                        </svg>
                        <span class="text-sm font-medium">Disciplina</span>
                    </div>
                    <div class="flex items-center space-x-3 text-green-300">
                        <svg class="w-5 h-5 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                        </svg>
                        <span class="text-sm font-medium">Confianza</span>
                    </div>
                </div>

                <!-- CTA Buttons -->
                <div class="flex flex-col sm:flex-row gap-4 pt-4" id="hero-cta">
                                         <a href="https://wa.me/543644598253?text=Hola,%20me%20interesa%20conocer%20más%20sobre%20sus%20servicios" 
                        class="group inline-flex items-center justify-center px-8 py-4 bg-green-600 text-white font-semibold rounded-lg hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2 transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-xl"
                          rel="noopener"                        
                       aria-label="Contactar por WhatsApp">
                        <svg class="w-5 h-5 mr-2 group-hover:animate-bounce" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.488"/>
                        </svg>
                        Contactar Ahora
                    </a>
                    <a href="#Servicios" 
                       class="group inline-flex items-center justify-center px-8 py-4 bg-transparent text-white font-semibold rounded-lg border-2 border-white/30 hover:border-white/60 hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white/50 focus:ring-offset-2 transition-all duration-300 transform hover:scale-105">
                        <span>Ver Servicios</span>
                        <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                        </svg>
                        </a>         
                    </div>
        </div>

            <!-- Right Column - Visual Elements -->
            <div class="relative hidden lg:block" id="hero-visual">
                <!-- Service Cards -->
                <div class="grid grid-cols-2 gap-4 max-w-md mx-auto">
                    <div class="bg-white/10 backdrop-blur-sm rounded-lg p-4 border border-white/20 hover:bg-white/20 transition-all duration-300 transform hover:scale-105" id="service-card-1">
                        <div class="w-12 h-12 bg-green-500/20 rounded-lg flex items-center justify-center mb-3">
                            <svg class="w-6 h-6 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                        </div>
                        <h3 class="text-white font-semibold mb-1">Control de Plagas</h3>
                        <p class="text-gray-300 text-sm">Soluciones integrales para todo tipo de infestaciones</p>
                    </div>
                    
                    <div class="bg-white/10 backdrop-blur-sm rounded-lg p-4 border border-white/20 hover:bg-white/20 transition-all duration-300 transform hover:scale-105" id="service-card-2">
                        <div class="w-12 h-12 bg-green-500/20 rounded-lg flex items-center justify-center mb-3">
                            <svg class="w-6 h-6 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M3 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"/>
                            </svg>
                        </div>
                        <h3 class="text-white font-semibold mb-1">Saneamiento</h3>
                        <p class="text-gray-300 text-sm">Limpieza y desinfección profesional</p>
    </div>
        
                    <div class="bg-white/10 backdrop-blur-sm rounded-lg p-4 border border-white/20 hover:bg-white/20 transition-all duration-300 transform hover:scale-105" id="service-card-3">
                        <div class="w-12 h-12 bg-green-500/20 rounded-lg flex items-center justify-center mb-3">
                            <svg class="w-6 h-6 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"/>
                            </svg>
                        </div>
                        <h3 class="text-white font-semibold mb-1">Tecnología</h3>
                        <p class="text-gray-300 text-sm">Equipos de última generación</p>
                    </div>
                    
                    <div class="bg-white/10 backdrop-blur-sm rounded-lg p-4 border border-white/20 hover:bg-white/20 transition-all duration-300 transform hover:scale-105" id="service-card-4">
                        <div class="w-12 h-12 bg-green-500/20 rounded-lg flex items-center justify-center mb-3">
                            <svg class="w-6 h-6 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                            </svg>
                        </div>
                        <h3 class="text-white font-semibold mb-1">Certificación</h3>
                        <p class="text-gray-300 text-sm">Profesionales habilitados</p>
                    </div>
                </div>
            </div>
        </div>
</div>

    <!-- Scroll Indicator -->
    <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce" id="scroll-indicator">
        <div class="w-6 h-10 border-2 border-white/30 rounded-full flex justify-center">
            <div class="w-1 h-3 bg-white/60 rounded-full mt-2 animate-pulse"></div>
        </div>
    </div>
</section>

<script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    
    gsap.registerPlugin(ScrollTrigger);

    // Hero animations
    const tl = gsap.timeline();

    // Initial animations
    tl.from('#hero-badge', {
        y: -50,
        opacity: 0,
        duration: 0.8,
        ease: "power2.out"
    })
    .from('#hero-title', {
        y: 50,
        opacity: 0,
        duration: 1,
        ease: "power2.out"
    }, "-=0.4")
    .from('#hero-description', {
        y: 30,
        opacity: 0,
        duration: 0.8,
        ease: "power2.out"
    }, "-=0.6")
    .from('#hero-features', {
        y: 30,
        opacity: 0,
        duration: 0.8,
        ease: "power2.out"
    }, "-=0.4")
    .from('#hero-cta', {
        y: 30,
        opacity: 0,
        duration: 0.8,
        ease: "power2.out"
    }, "-=0.4");

    // Service cards animation
    gsap.fromTo(['#service-card-1', '#service-card-2', '#service-card-3', '#service-card-4'], 
        { y: 50, opacity: 0 },
        { 
            y: 0, 
            opacity: 1, 
            duration: 0.8,
            stagger: 0.1,
            ease: "power2.out",
            delay: 0.5
        }
    );

    // Floating elements animation
    gsap.to('#floating-1', {
        y: -20,
        x: 10,
        duration: 3,
        repeat: -1,
        yoyo: true,
        ease: "power1.inOut"
    });

    gsap.to('#floating-2', {
        y: 15,
        x: -15,
        duration: 4,
        repeat: -1,
        yoyo: true,
        ease: "power1.inOut"
    });

    gsap.to('#floating-3', {
        y: -10,
        x: 20,
        duration: 3.5,
        repeat: -1,
        yoyo: true,
        ease: "power1.inOut"
    });

    // Parallax effect for background
    gsap.to('#hero-bg', {
        yPercent: -20,
        ease: "none",
        scrollTrigger: {
            trigger: "section",
            start: "top bottom",
            end: "bottom top",
            scrub: true
        }
    });

    // Scroll indicator animation
    gsap.to('#scroll-indicator', {
        opacity: 0,
        y: -20,
        duration: 1,
        ease: "power2.out",
        scrollTrigger: {
            trigger: "section",
            start: "top top",
            end: "bottom top",
            scrub: true
        }
    });

    // Additional scroll animations can be added here if needed
</script>


