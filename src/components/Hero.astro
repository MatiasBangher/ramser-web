---
import Photo from './Photo.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import { business, waLink } from '../data/site';
---

<section id="inicio" aria-label="Inicio" class="pt-16 lg:pt-20">
	<div class="on-photo relative flex min-h-[88svh] flex-col justify-end overflow-hidden bg-ink">
		<div data-hero-photo class="absolute inset-0">
			<div data-hero-parallax class="absolute inset-x-0 -bottom-[8%] -top-[8%]">
				<Photo
					image="hero1"
					alt="Técnico de RAMSER realizando un tratamiento de fumigación"
					widths={[640, 960, 1280, 1600, 1920]}
					sizes="100vw"
					loading="eager"
					position="62% 50%"
					class="h-full"
				/>
			</div>
		</div>
		<div class="pointer-events-none absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-ink/90 via-ink/50 to-transparent" aria-hidden="true"></div>

		<p class="mono-label absolute right-5 top-5 max-w-[16rem] bg-ink/75 px-2.5 py-1.5 text-right text-paper md:right-10 md:top-8">
			FIG. 01 — Tratamiento de fumigación — Chaco
		</p>

		<div class="relative mx-auto w-full max-w-page px-5 pb-10 pt-40 md:px-10 md:pb-14">
			<h1 class="display max-w-[18ch] text-[clamp(3rem,8vw,7.5rem)] leading-[0.92] text-paper">
				<span data-split class="block">Saneamiento ambiental y control de plagas</span>
				<span data-split class="block italic">en el Chaco.</span>
			</h1>
		</div>
	</div>

	<div class="on-ink bg-ink text-paper">
		<div class="mx-auto grid w-full max-w-page grid-cols-1 divide-y divide-paper/25 px-5 md:grid-cols-3 md:divide-x md:divide-y-0 md:px-10">
			<p data-hero-cell class="mono-label py-4 md:pr-6">
				Hab. Prov. N°{business.license.number} — {business.license.issuer.replace(' - Provincia del Chaco', ' del Chaco')}
			</p>
			<p data-hero-cell class="mono-label py-4 md:px-6">{business.address.addressLocality} · NEA</p>
			<p data-hero-cell class="mono-label py-4 md:pl-6">
				<a href={waLink('hero')} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 py-1 underline decoration-paper/60 underline-offset-[6px] hover:decoration-paper">
					<WhatsAppIcon class="h-3.5 w-3.5" />
					Escribinos por WhatsApp →
				</a>
			</p>
		</div>
	</div>

	<div class="mx-auto w-full max-w-page px-5 pb-8 pt-12 md:px-10 md:pt-20">
		<div class="grid grid-cols-12 gap-x-6">
			<p class="text-[1.1875rem] leading-[1.55] text-ink md:col-span-7 md:col-start-3 col-span-12">
				Empresa líder en <strong class="font-semibold">fumigación y control de plagas</strong> en la región NEA, con domicilio en
				<strong class="font-semibold">Pampa del Infierno, Chaco</strong>. Ofrecemos servicios profesionales de
				<strong class="font-semibold">desinsectación, desratización y saneamiento ambiental</strong> con la más alta calidad y tecnología.
			</p>
		</div>
	</div>
</section>
